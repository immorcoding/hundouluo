# Godot editor cache (generated locally)
.godot/

# rc.2 review captures are evidence, not runtime imports.
docs/art/issue-31-rc2/frames/
docs/art/issue-31-rc2/**/*.png.import
docs/art/issue-31-rc2/**/*.gif.import

# Python-generated files from art tooling
__pycache__/
*.pyc

# #33 reproducible raw capture frames and review-image import caches.
docs/art/issue-33/frames/
docs/art/issue-33/*.png.import
docs/art/issue-33/*.gif.import

# Review-only captures/previews are re-imported locally by the editor.
docs/art/issue-31/frames/
docs/art/issue-31/*.png.import
docs/art/issue-31/*.gif.import
docs/art/issue-31/*.webp.import
docs/art/*.png.import
docs/art/concepts/*.png.import
assets/art_source/*.png.import
